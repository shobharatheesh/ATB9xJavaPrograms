		{
			"name": "GetStudent",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"\r",
							"pm.test(\"Validate student details\", () => { \r",
							"var jsonData = pm.response.json(); \r",
							"pm.expect(jsonData.id).to.eql(pm.environment.get(\"id\")); \r",
							"pm.expect(jsonData.name).to.eql(\"Scott\"); \r",
							"pm.expect(jsonData.location).to.eql(\"France\"); \r",
							"}); \r",
							"\r",
							"const schema = {\r",
							"    \"type\": \"object\",\r",
							"    \"properties\": {\r",
							"        \"id\": {\"type\": \"string\"},\r",
							"        \"name\": {\"type\": \"string\"},\r",
							"        \"location\": {\"type\": \"string\"}\r",
							"    },\r",
							"    \"required\": [\"id\",\"name\",\"location\"]\r",
							"};\r",
							"pm.test(\"Schema validation\", function () {\r",
							"    pm.response.to.have.jsonSchema(schema);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:3000/students/{{id}}",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "3000",
					"path": [
						"students",
						"{{id}}"
					]
				}
			},
			"response": []
