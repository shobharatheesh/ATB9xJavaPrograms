	"item": [
		{
			"name": "CreateUser",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"//generate random text\r",
							"const text =Math.random().toString(36).substring(2);\r",
							"const email =text+\"@gmail.com\";\r",
							"\r",
							"console.log(email);\r",
							"\r",
							"pm.collectionVariables.set(\"username\",\"xyz\");\r",
							"pm.collectionVariables.set(\"useremail\",email);\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"\r",
							"const jsonData =pm.response.json(); //capture the whole respose \r",
							"//we need to capture only id\r",
							"//we can use jsonData.id\r",
							"pm.collectionVariables.set(\"userid\",jsonData.id);\r",
							"console.log(jsonData.id)\r",
							"\r",
							"\r",
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"User is created with the correct name, email, gender, and status\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.name).to.eql(\"xyz\");\r",
							"    pm.expect(jsonData.gender).to.eql(\"male\");\r",
							"    pm.expect(jsonData.status).to.eql(\"inactive\");\r",
							"});\r",
							"\r",
							"pm.test(\"Status code has string 'Created'\", function () {\r",
							"    pm.response.to.have.status('Created');\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n \"name\": \"{{username}}\",\r\n \"gender\": \"male\",\r\n \"email\": \"{{useremail}}\",\r\n \"status\": \"inactive\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://gorest.co.in/public/v2/users",
					"protocol": "https",
					"host": [
						"gorest",
						"co",
						"in"
					],
					"path": [
						"public",
						"v2",
						"users"
					]
				}
			},
			"response": []
		},
		{
			"name": "GetUser",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json(); //capture the whole response\r",
							"\r",
							"// Validate the variables\r",
							"pm.test(\"Variables should be set\", function () {\r",
							"    pm.expect(pm.variables.get(\"userid\")).to.equal(jsonData.id); // Validate the 'id' variable\r",
							"    pm.expect(pm.variables.get(\"username\")).to.equal(jsonData.name); // Validate the 'name' variable\r",
							"    pm.expect(pm.variables.get(\"useremail\")).to.equal(jsonData.email); // Validate the 'email' variable\r",
							"});\r",
							"\r",
							"// Validate the JSON Fields\r",
							"pm.test(\"Validate Json Fields\", ()=> {\r",
							"    pm.expect(jsonData.id).to.equal(pm.variables.get(\"userid\"));\r",
							"    pm.expect(jsonData.name).to.equal(pm.variables.get(\"username\"));\r",
							"    pm.expect(jsonData.email).to.equal(pm.variables.get(\"useremail\"));\r",
							"});\r",
							""
